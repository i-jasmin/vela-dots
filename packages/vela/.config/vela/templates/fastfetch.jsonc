// Generated by matugen -- edits are overwritten on the next `vela wallpaper`.
// Source template: ~/.config/vela/templates/fastfetch.jsonc
//
// The greeting a new terminal opens with (`vela greet`), and plain
// `fastfetch` too. Every colour is a palette role, by the terminal colour
// slot kitty-colours.conf gives it (255 primary, 254 its container, 253
// secondary, 252 its container, 251 tertiary, 250 its container, 249
// outline-variant; 8 outline, 7 on-surface-variant, 1 error, and the default
// foreground on-surface) -- never as a truecolor code. A truecolor code is
// the colour for good: a greeting printed before a new wallpaper, or before
// a switch to light, kept the old palette, pale on a light background. A
// slot is looked up as the text is drawn, and `vela retint` sets the slots
// in every open kitty, so the greeting changes with everything else.
//
// Just the information, no logo and no picture: the terminal's own padding
// is the margin.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": { "type": "none" },
  "display": {
    "separator": "  ",
    // Where the values start: fastfetch jumps to this column rather than
    // padding, so it has to clear the longest key and the separator after it.
    "key": { "width": 14 },
    "color": {
      "keys": "38;5;255",
      "title": "38;5;251",
      "output": "39",
      "separator": "38;5;8"
    },
    // Memory's percentage: quiet while there is room, the tertiary role as it
    // fills, the error role when it is nearly full.
    "percent": {
      "color": {
        "green": "38;5;7",
        "yellow": "38;5;251",
        "red": "38;5;1"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "38;5;255",
        "at": "38;5;8",
        "host": "38;5;251"
      }
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "38;5;249"
    },
    { "type": "os", "key": "  os" },
    { "type": "kernel", "key": "  kernel" },
    { "type": "wm", "key": "󰖯  wm" },
    { "type": "shell", "key": "󰆍  shell" },
    { "type": "terminal", "key": "  term" },
    { "type": "uptime", "key": "󰅐  uptime" },
    { "type": "packages", "key": "󰏖  packages" },
    { "type": "memory", "key": "󰍛  memory" },
    "break",
    // The palette the wallpaper gave: primary, secondary and tertiary, then
    // their containers.
    {
      "type": "custom",
      "format": "{#38;5;255}●  {#38;5;253}●  {#38;5;251}●  {#38;5;254}●  {#38;5;252}●  {#38;5;250}●"
    }
  ]
}
