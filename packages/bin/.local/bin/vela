#!/usr/bin/env bash
# vela -- control script for the vela desktop shell.
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/vela"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/vela"
MATUGEN_CONFIG="$CONFIG_DIR/matugen.toml"
SHELL_CONFIG="$CONFIG_DIR/shell.json"
# Shared with services/Wallpaper.qml, so the CLI and the shell agree on which
# wallpaper is current whether or not the shell is running.
WALLPAPER_STATE="$STATE_DIR/wallpaper.json"

die() { printf 'vela: %s\n' "$1" >&2; exit 1; }

usage() {
    cat <<'USAGE'
usage: vela <command> [args]

  wallpaper <path> [--light|--dark]   Set the wallpaper and retheme from it
  wallpaper                           Print the current wallpaper path
  theme [light|dark|toggle]           Switch light/dark and retheme
  retint <image> [light|dark] [scheme]
                                      Regenerate every palette from an image
                                      (what the shell runs; no wallpaper change)
  shell [start|stop|restart|log]      Manage the Quickshell instance
  icon-theme                          List the icon themes installed, the
                                      one in use marked
  icon-theme <name>|vela              Draw app icons from that theme, in the
                                      shell and in GTK apps ("vela": the
                                      shell's own symbols); restarts the shell
  icon-theme --json                   The same list with a few icons from
                                      each (what Settings reads)
  colours                             Print the current generated palette
  greet                               The terminal greeting: fastfetch in the
                                      palette
  calendar [list|sync [id]|remove <id>|keyring]
                                      The calendars Home's month shows: list
                                      the accounts, sync them, remove one,
                                      check the keyring their secrets are in
  calendar add                        Add an account, from VELA_CAL_PROVIDER,
                                      _NAME, _URL, _USER and _PASS (what the
                                      settings window runs)
  calendar event add|edit <uid>|delete <uid>
                                      Write an event into a CalDAV calendar,
                                      from VELA_EV_PATH, _TITLE, _START, _END
                                      and _LOCATION (what Home's month runs)
  doctor                              Check what is installed, linked and
                                      running, and what is missing
  idle on power|battery               Succeed only on that power source (what
                                      hypridle's listeners check)
  idle dim|undim                      Dim the backlight for idle, and put it
                                      back
  ai status                           Claude Code and Codex: plan usage and
                                      what each session is doing (JSON, what
                                      the shell reads)
  ai claude-usage                     Ask Claude Code for what /usage shows
                                      (every window, Fable's week included)
  ai icons [--force]                  Fetch the Claude Code and Codex logos
                                      the cards and the bar pill draw
  ai connect|disconnect claude|codex  Add or remove vela's status line and
                                      hooks in that tool's settings (a backup
                                      is saved first)
  ai statusline | ai hook <tool>      What Claude Code and Codex run once
                                      connected
USAGE
}

# Read one value out of a JSON file: json_get <file> <key> [<key>...]
json_get() {
    python3 - "$@" <<'PY' 2>/dev/null
import json, sys
try:
    v = json.load(open(sys.argv[1]))
    for k in sys.argv[2:]:
        v = v[k]
    print(v)
except Exception:
    sys.exit(1)
PY
}

current_wallpaper() {
    json_get "$WALLPAPER_STATE" current && return
    # Written by matugen on every retint, so it knows the last image even if
    # the shell never ran.
    json_get "$STATE_DIR/colours.json" wallpaper
}

# The mode the last retint used, lower-case: "light" or "dark".
last_mode() {
    local m
    m=$(json_get "$STATE_DIR/colours.json" mode) || m=dark
    case "$m" in
        [Ll]ight) echo light ;;
        *)        echo dark ;;
    esac
}

# The mode to retint in when none is given: shell.json's, unless that is
# "auto" (only the running shell knows where the sun is), then the last one.
preferred_mode() {
    local m
    m=$(json_get "$SHELL_CONFIG" appearance mode) || m=""
    case "$m" in
        light|dark) echo "$m" ;;
        *)          last_mode ;;
    esac
}

scheme_type() {
    json_get "$SHELL_CONFIG" appearance scheme || echo scheme-tonal-spot
}

# qs exits 255 when no instance of the config is running.
shell_running() {
    command -v qs >/dev/null 2>&1 && qs -c vela ipc show >/dev/null 2>&1
}

# Set appearance.mode in shell.json. The shell watches that file, so a running
# shell switches immediately and re-runs the retint for the other apps itself.
set_shell_mode() {
    [ -f "$SHELL_CONFIG" ] || return 0
    python3 - "$SHELL_CONFIG" "$1" <<'PY'
import json, sys
path, mode = sys.argv[1], sys.argv[2]
with open(path) as f:
    cfg = json.load(f)
cfg.setdefault("appearance", {})["mode"] = mode
with open(path + ".tmp", "w") as f:
    json.dump(cfg, f, indent=4)
    f.write("\n")
import os
os.replace(path + ".tmp", path)
PY
}

# Record the wallpaper where the shell will find it on its next start.
record_wallpaper() {
    mkdir -p "$STATE_DIR"
    python3 - "$WALLPAPER_STATE" "$1" <<'PY'
import json, os, sys
path, wall = sys.argv[1], sys.argv[2]
try:
    s = json.load(open(path))
except Exception:
    s = {}
if s.get("current") and s["current"] != wall:
    s["previous"] = s["current"]
s["current"] = wall
s["perMonitor"] = {}
with open(path + ".tmp", "w") as f:
    json.dump(s, f)
os.replace(path + ".tmp", path)
PY
}

# Push new colours into apps that are already running.
#
# The shell, Hyprland and fuzzel all watch their generated files and need
# nothing. These two do not:
#
#   kitty  reads its config only at startup, but every instance listens on
#          unix:@mykitty-<pid> (see listen_on in kitty.conf), and set-colors
#          applies a palette live. SIGUSR1 does not do it.
#   cava   reads its colours at startup, and SIGUSR2 reloads them. The shell's
#          own cava -- its waveform, `-p ~/.cache/vela/cava.conf` -- has no
#          colours to reload and is left alone.
#   GTK    reads ~/.config/gtk-{3,4}.0/gtk.css once, at startup, and offers no
#          way to reload it. The gsettings in set_colour_scheme keep light/dark
#          consistent for anything that consults them -- libadwaita, and
#          Chromium and Firefox, which follow the portal's colour scheme live --
#          and take effect for apps launched from now on; already-open GTK3
#          windows keep their old accent colours until they are restarted.
#
# Every kitty is told at once rather than one after another: each `kitty @`
# is a process of its own that takes a moment to start, and in turn they
# added up to the terminals changing well after everything else.
notify_running_apps() {
    if command -v kitty >/dev/null 2>&1; then
        local pid
        for pid in $(pgrep -x kitty 2>/dev/null || true); do
            kitty @ --to "unix:@mykitty-$pid" set-colors --all --configured \
                "${XDG_CONFIG_HOME:-$HOME/.config}/kitty/colours.conf" >/dev/null 2>&1 &
        done
    fi

    local pid args
    while read -r pid args; do
        case "$args" in *vela/cava.conf*) continue ;; esac
        kill -USR2 "$pid" 2>/dev/null || true
    done < <(pgrep -a -x cava 2>/dev/null || true)

    wait
}

# Light or dark for everything that asks the desktop: said first, before the
# palette is regenerated, because it needs nothing from it and browsers and
# libadwaita apps take a moment to repaint after hearing it.
set_colour_scheme() {
    command -v gsettings >/dev/null 2>&1 || return 0
    if [ "$1" = "light" ]; then
        gsettings set org.gnome.desktop.interface color-scheme 'prefer-light' 2>/dev/null || true
        gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3' 2>/dev/null || true
    else
        gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true
        gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dark' 2>/dev/null || true
    fi
}

# Regenerate every template from an image. The single place matugen is run to
# write anything: the shell's wallpaper switcher calls this too.
#
# `--source-color-index 0` takes the most dominant colour. Without it matugen 4
# asks which of several candidates to use, and with no terminal attached -- the
# shell, a keybind -- it exits with an error instead. The Fedora COPRs do not
# all carry the same matugen: some have the option only under `image`, some
# not at all, and one that lacks it refuses the whole command if given it. So
# it is passed after `image`, and only to a matugen that lists it there; and if
# matugen still cannot settle on a colour, the image's own dominant colour is
# worked out here and the palette made from that (`matugen color`).
# The scheme is shell.json's unless given. The shell gives it: it has just
# written a new one there, and that write can land after this reads the file.
matugen_source_args() {
    if matugen image --help 2>/dev/null | grep -q -- '--source-color-index'; then
        printf '%s\n' --source-color-index 0
    fi
}

# The most common colour in the image, as #rrggbb, preferring one with some
# colour in it over a grey: a stand-in for matugen's own choice.
dominant_colour() {
    local im
    im=$(command -v magick || command -v convert) || return 1
    "$im" "$1" -resize 96x96 -colors 8 -depth 8 -format '%c' histogram:info:- 2>/dev/null \
        | awk 'function h(x,   i, n) { n = 0; x = tolower(x); for (i = 1; i <= length(x); i++) n = n * 16 + index("0123456789abcdef", substr(x, i, 1)) - 1; return n }
        {
            count = $1 + 0
            if (match($0, /#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]/) == 0) next
            hex = substr($0, RSTART, 7)
            r = h(substr(hex, 2, 2)); g = h(substr(hex, 4, 2)); b = h(substr(hex, 6, 2))
            hi = r; if (g > hi) hi = g; if (b > hi) hi = b
            lo = r; if (g < lo) lo = g; if (b < lo) lo = b
            score = count * (hi - lo > 24 ? 4 : 1)
            if (score > best) { best = score; pick = hex }
        } END { if (pick) print pick; else exit 1 }'
}

cmd_retint() {
    local path="${1:-}" mode="${2:-}" scheme="${3:-}"
    [ -n "$path" ] || die "usage: vela retint <image> [light|dark] [scheme]"
    [ -f "$path" ] || die "no such file: $path"
    [ -f "$MATUGEN_CONFIG" ] || die "missing $MATUGEN_CONFIG (did you stow the vela package?)"
    command -v matugen >/dev/null 2>&1 || die "matugen is not installed"
    [ -n "$mode" ] || mode=$(preferred_mode)
    case "$mode" in
        light|dark) ;;
        *) die "unknown mode: $mode (use light or dark)" ;;
    esac
    [ -n "$scheme" ] || scheme=$(scheme_type)
    local config="${XDG_CONFIG_HOME:-$HOME/.config}"
    mkdir -p "$STATE_DIR" "$config/gtk-3.0" "$config/gtk-4.0" "$config/fastfetch" "$config/cava"
    set_colour_scheme "$mode"
    # matugen's own complaint is kept back unless the fallback fails too: a
    # recovered retint should not look like an error. Nor is the fallback
    # named until it has worked -- a template matugen cannot write fails it
    # as well, and is then told as what it is, not as a colour it could not
    # pick.
    local source_args colour err again
    mapfile -t source_args < <(matugen_source_args)
    if ! err=$(matugen --config "$MATUGEN_CONFIG" -q -t "$scheme" -m "$mode" image "${source_args[@]}" "$path" 2>&1 </dev/null); then
        if ! colour=$(dominant_colour "$path") \
            || ! again=$(matugen --config "$MATUGEN_CONFIG" -q -t "$scheme" -m "$mode" color hex "$colour" 2>&1 </dev/null); then
            printf '%s\n' "$err" >&2
            [ -z "${again:-}" ] || [ "$again" = "$err" ] || printf '%s\n' "$again" >&2
            die "matugen could not make a palette from $path"
        fi
        printf 'vela: matugen could not pick a colour from the image; used its dominant colour, %s\n' "$colour" >&2
    fi
    notify_running_apps
}

# The greeting a new terminal opens with: fastfetch, in the palette (its
# config is a matugen template), information only.
cmd_greet() {
    command -v fastfetch >/dev/null 2>&1 || return 0
    exec fastfetch
}

# Switch light/dark without naming a wallpaper.
cmd_theme() {
    local mode="${1:-toggle}" wall

    if [ "$mode" = "toggle" ]; then
        case "$(preferred_mode)" in
            light) mode=dark ;;
            *)     mode=light ;;
        esac
    fi

    case "$mode" in
        light|dark) ;;
        *) die "unknown mode: $mode (use light, dark or toggle)" ;;
    esac

    set_shell_mode "$mode"
    if shell_running; then
        printf 'vela: %s mode\n' "$mode"
        return
    fi

    wall=$(current_wallpaper) || die "no wallpaper set yet; run: vela wallpaper <path>"
    cmd_retint "$wall" "$mode"
    printf 'vela: retinted from %s (%s)\n' "$wall" "$mode"
}

cmd_wallpaper() {
    if [ $# -eq 0 ]; then
        current_wallpaper || die "no wallpaper set yet"
        return
    fi

    local path mode=""
    path=$(realpath -e "$1") || die "no such file: $1"
    shift
    case "${1:-}" in
        --light) mode=light ;;
        --dark)  mode=dark ;;
        "")      ;;
        *) die "unknown option: $1" ;;
    esac

    [ -z "$mode" ] || set_shell_mode "$mode"

    # A running shell owns the wallpaper: it draws it, keeps the previous one
    # for super + shift + W, and runs the retint itself.
    if shell_running; then
        qs -c vela ipc call wallpaper apply "$path" >/dev/null
        printf 'vela: wallpaper set to %s\n' "$path"
        return
    fi

    [ -n "$mode" ] || mode=$(preferred_mode)
    record_wallpaper "$path"
    cmd_retint "$path" "$mode"
    printf 'vela: retinted from %s (%s)\n' "$path" "$mode"
}

cmd_shell() {
    case "${1:-restart}" in
        # -n: a second start while one is up would otherwise be a second
        # shell -- two bars, and IPC calls landing on either.
        #
        # With the icon theme chosen in Settings (Appearance, App icons).
        # Quickshell reads QS_ICON_THEME once, as it starts, and cannot change
        # it afterwards -- which is why choosing one restarts the shell. Unset
        # for vela's own symbols, so a value left in the environment by
        # whatever ran this script cannot outlive the choice.
        start)
            local theme
            theme=$(icon_themes start) || theme=""
            if [ -n "$theme" ]; then
                QS_ICON_THEME="$theme" qs -c vela -n -d
            else
                env -u QS_ICON_THEME qs -c vela -n -d
            fi
            ;;
        # Never pkill -f here: the pattern also matches the shell running this script.
        # `qs kill` only asks, so this waits (up to 3 s) until it has gone.
        stop)
            qs kill -c vela >/dev/null 2>&1 || true
            local i
            for i in $(seq 30); do
                shell_running || break
                sleep 0.1
            done
            ;;
        restart) cmd_shell stop; cmd_shell start ;;
        log)     qs log -c vela -f ;;
        *)       die "unknown shell command: $1" ;;
    esac
}

# ---- app icons -----------------------------------------------------------
#
# Which icons applications are drawn with: vela's own Material symbols (the
# default, `iconTheme` empty in shell.json), or an icon theme installed on the
# machine -- in the shell (launcher, dock, alt + tab, the overview, the window
# title, notifications) and, through GTK's own setting, in Files, Settings and
# the other GTK apps. With vela's symbols the apps keep Adwaita, Fedora's
# own: the symbols are a font for the shell, not an icon theme an app can use.
#
#   icon_themes list        the installed themes, for a person
#   icon_themes json        the same with a few icons from each, for Settings
#   icon_themes set NAME    choose one ("vela" for the symbols): shell.json
#                           and GTK; the caller restarts the shell
#   icon_themes start       the theme the shell should start with, or nothing
#
# Themes are found where the freedesktop icon theme spec looks, the user's own
# folders first, so a theme copied into ~/.local/share/icons wins over a
# packaged one of the same name. A folder there is an icon theme if its
# index.theme lists directories: a cursor theme (Bibata) has only cursors/,
# and hicolor is the fallback every theme ends in rather than a look of its own.
icon_themes() {
    python3 - "$SHELL_CONFIG" "$@" <<'PY'
import configparser, json, os, shutil, subprocess, sys

config_path = sys.argv[1]
cmd = sys.argv[2] if len(sys.argv) > 2 else "list"
arg = sys.argv[3] if len(sys.argv) > 3 else ""
home = os.path.expanduser("~")


def die(message):
    print(f"vela: {message}", file=sys.stderr)
    sys.exit(1)


def icon_bases():
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.join(home, ".local", "share")
    wanted = [os.path.join(data_home, "icons"), os.path.join(home, ".icons")]
    for d in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":"):
        if d:
            wanted.append(os.path.join(d, "icons"))
    out, seen = [], set()
    for b in wanted:
        real = os.path.realpath(b)
        if real not in seen and os.path.isdir(b):
            seen.add(real)
            out.append(b)
    return out


BASES = icon_bases()
INDEXES = {}


def index_of(tid):
    # The first index.theme found for a name is the one that describes it.
    if tid not in INDEXES:
        INDEXES[tid] = None
        for b in BASES:
            path = os.path.join(b, tid, "index.theme")
            if not os.path.isfile(path):
                continue
            parser = configparser.RawConfigParser(strict=False)
            parser.optionxform = str
            try:
                with open(path, encoding="utf-8", errors="replace") as f:
                    parser.read_file(f)
            except Exception:
                continue
            if parser.has_section("Icon Theme"):
                INDEXES[tid] = parser
                break
    return INDEXES[tid]


def directories(idx):
    meta = idx["Icon Theme"]
    names = (meta.get("Directories", "") + "," + meta.get("ScaledDirectories", "")).split(",")
    return list(dict.fromkeys(n.strip() for n in names if n.strip()))


def installed():
    themes, seen = [], set()
    for b in BASES:
        try:
            names = sorted(os.listdir(b))
        except OSError:
            continue
        for tid in names:
            if tid in seen or tid in ("hicolor", "locolor", "default"):
                continue
            idx = index_of(tid)
            if idx is None:
                continue
            seen.add(tid)
            meta = idx["Icon Theme"]
            if meta.get("Hidden", "").strip().lower() == "true" or not directories(idx):
                continue
            themes.append({"id": tid, "name": meta.get("Name", "").strip() or tid, "path": os.path.join(b, tid)})
    themes.sort(key=lambda t: t["name"].lower())
    return themes


# Five applications nearly every theme draws, each with a few names it might
# go by, for the row of icons Settings shows beside a theme. The first name a
# theme itself has wins; hicolor -- each app's own icon -- only answers once the
# theme and what it inherits have nothing, which is what Adwaita, with almost no
# application icons of its own, shows.
PREVIEW = [
    ["google-chrome", "firefox", "org.mozilla.firefox", "chromium-browser", "chromium", "brave-browser", "web-browser", "internet-web-browser"],
    ["kitty", "com.mitchellh.ghostty", "org.gnome.Ptyxis", "org.gnome.Console", "org.gnome.Terminal", "utilities-terminal"],
    ["org.gnome.Nautilus", "system-file-manager", "file-manager", "nautilus"],
    ["code", "visual-studio-code", "com.visualstudio.code", "dev.zed.Zed", "org.gnome.TextEditor", "accessories-text-editor"],
    ["discord", "com.discordapp.Discord", "org.telegram.desktop", "telegram", "signal-desktop", "org.gnome.Settings", "preferences-system"],
]


def app_dirs(tid):
    # A theme's application folders, the size closest to how big Settings draws
    # them first and scalable before that.
    idx = index_of(tid)
    if idx is None:
        return []

    def rank(d):
        sec = idx[d] if idx.has_section(d) else {}
        try:
            size = int(sec.get("Size", "0"))
        except ValueError:
            size = 0
        return (0 if sec.get("Type", "") == "Scalable" else 1, abs(size - 64), 0 if sec.get("Scale", "1") == "1" else 1)

    apps = [d for d in directories(idx) if (idx[d].get("Context", "") if idx.has_section(d) else "") == "Applications" or "apps" in d.split("/")]
    out = []
    for d in sorted(apps, key=rank):
        for b in BASES:
            full = os.path.join(b, tid, d)
            if os.path.isdir(full):
                out.append(full)
    return out


def chain(tid):
    out, queue = [], [tid]
    while queue and len(out) < 8:
        t = queue.pop(0)
        if t in out or t == "hicolor" or index_of(t) is None:
            continue
        out.append(t)
        queue += [i.strip() for i in index_of(t)["Icon Theme"].get("Inherits", "").split(",") if i.strip()]
    return out


def preview(tid):
    styled = [d for t in chain(tid) for d in app_dirs(t)]
    fallback = app_dirs("hicolor")
    found = []
    for names in PREVIEW:
        hit = None
        for dirs in (styled, fallback):
            for name in names:
                for d in dirs:
                    for ext in (".svg", ".png"):
                        path = os.path.join(d, name + ext)
                        if os.path.exists(path):
                            hit = path
                            break
                    if hit:
                        break
                if hit:
                    break
            if hit:
                break
        if hit:
            found.append(hit)
    return found


def read_config():
    try:
        with open(config_path) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}
    except Exception as e:
        die(f"cannot read {config_path}: {e}")


def current():
    value = read_config().get("appearance", {}).get("iconTheme", "")
    return value if isinstance(value, str) else ""


if cmd == "start":
    tid = current()
    if tid and index_of(tid) is not None:
        print(tid)
elif cmd == "json":
    themes = installed()
    for t in themes:
        t["preview"] = preview(t["id"])
    print(json.dumps({"current": current(), "themes": themes}))
elif cmd == "list":
    tid = current()
    rows = [("vela", "vela's own symbols", tid == "")] + [(t["id"], t["name"], t["id"] == tid) for t in installed()]
    width = max(len(r[0]) for r in rows)
    for key, name, on in rows:
        print(f"{'*' if on else ' '} {key.ljust(width)}  {name}")
elif cmd == "set":
    if arg in ("", "vela"):
        tid = ""
    else:
        themes = installed()
        match = next((t for t in themes if t["id"] == arg), None) or next((t for t in themes if t["name"].lower() == arg.lower()), None)
        if match is None:
            die(f"no icon theme called {arg} is installed (vela icon-theme lists them)")
        tid = match["id"]
    cfg = read_config()
    cfg.setdefault("appearance", {})["iconTheme"] = tid
    os.makedirs(os.path.dirname(config_path), exist_ok=True)
    with open(config_path + ".tmp", "w") as f:
        json.dump(cfg, f, indent=4)
        f.write("\n")
    os.replace(config_path + ".tmp", config_path)
    # GTK apps read their icon theme from here, and pick a change up live.
    # Adwaita is what they had before anything chose for them.
    if shutil.which("gsettings"):
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", tid or "Adwaita"], stderr=subprocess.DEVNULL, check=False)
    print(tid or "vela's own symbols")
else:
    die(f"unknown icon_themes command: {cmd}")
PY
}

cmd_icon_theme() {
    case "${1:-}" in
        "")     icon_themes list ;;
        --json) icon_themes json ;;
        -*)     die "unknown option: $1 (try 'vela help')" ;;
        *)
            local chosen reopen=0
            [ "${2:-}" = "--settings" ] && reopen=1
            chosen=$(icon_themes set "$1") || exit 1
            if ! shell_running; then
                printf 'vela: app icons: %s (from the next time the shell starts)\n' "$chosen"
                return
            fi
            # The theme is the shell's from the moment it starts, so it starts
            # again. Settings asked from inside the shell this restart closes,
            # and is opened back where it was.
            cmd_shell restart
            if [ "$reopen" = 1 ]; then
                for _ in $(seq 50); do
                    shell_running && break
                    sleep 0.1
                done
                qs -c vela ipc call shell settings appearance >/dev/null 2>&1 || true
            fi
            printf 'vela: app icons: %s\n' "$chosen"
            ;;
    esac
}

# What hypridle's listeners run when a laptop has one set of timeouts for on
# power and another for on battery (Settings, Lock screen). hypridle knows
# nothing of power, so a listener that is for one of the two asks as it
# fires, `if vela idle on battery; then loginctl lock-session; fi`, and does
# nothing on the other. A listener with no such check is for both, which is all a
# desktop ever has.
#
# On battery is UPower's answer, the one the bar's battery shows; without
# UPower, a battery (not a mouse's) with no charger online. Anything that
# cannot be read counts as on power, so a listener for on power still acts.
on_battery() {
    local v s online=0 battery=0
    if v=$(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower org.freedesktop.UPower OnBattery 2>/dev/null); then
        [ "$v" = "b true" ]
        return
    fi
    for s in /sys/class/power_supply/*; do
        [ -r "$s/type" ] || continue
        case "$(cat "$s/type" 2>/dev/null)" in
            Mains|USB*) [ "$(cat "$s/online" 2>/dev/null)" = 1 ] && online=1 ;;
            Battery)    [ "$(cat "$s/scope" 2>/dev/null)" = Device ] || battery=1 ;;
        esac
    done
    [ "$battery" = 1 ] && [ "$online" = 0 ]
}

# Dimming, when there are two dim listeners: with a power cord pulled halfway
# through, both can fire in one idle stretch, and the second must not save
# the dimmed level as the one to go back to. So it saves only from above the
# dim level -- which also leaves a screen already down at 5% alone rather
# than brightening it -- and waking puts back only what was dimmed.
IDLE_DIM=10
IDLE_DIMMED="${XDG_RUNTIME_DIR:-/tmp}/vela-idle-dimmed"

cmd_idle() {
    case "${1:-}" in
        on)
            case "${2:-}" in
                battery) on_battery ;;
                power)   ! on_battery ;;
                *)       die "usage: vela idle on power|battery" ;;
            esac
            ;;
        dim)
            local now
            now=$(brightnessctl -m 2>/dev/null | cut -d, -f4 | tr -d %) || return 0
            [ -n "$now" ] && [ "$now" -gt "$IDLE_DIM" ] || return 0
            brightnessctl -s set "$IDLE_DIM%" >/dev/null && : > "$IDLE_DIMMED"
            ;;
        undim)
            [ -e "$IDLE_DIMMED" ] || return 0
            rm -f "$IDLE_DIMMED"
            brightnessctl -r >/dev/null
            ;;
        *) die "usage: vela idle on power|battery | dim | undim" ;;
    esac
}

# What is there and what is not: the packages the desktop needs, the fonts,
# the links into the repo, the palette. For a machine vela has just gone on,
# or one where something stopped working. Exits 1 when something the desktop
# cannot come up without is missing, so the installer can tell.
DOCTOR_HYPRLAND_MIN=0.56

cmd_doctor() {
    local repo bad=0 G="" R="" Y="" N=""
    repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../.." && pwd)"
    if [ -t 1 ]; then G=$'\033[32m' R=$'\033[31m' Y=$'\033[33m' N=$'\033[0m'; fi
    pass() { printf '  %s✓%s %s\n' "$G" "$N" "$1"; }
    fail() { printf '  %s✗%s %s\n' "$R" "$N" "$1"; bad=1; }
    note() { printf '  %s•%s %s\n' "$Y" "$N" "$1"; }

    echo "vela doctor"

    # The system, and Hyprland new enough for the Lua config.
    if [ -r /etc/os-release ]; then
        # shellcheck disable=SC1091
        ( . /etc/os-release; [ "${ID:-}" = fedora ] ) && pass "$(. /etc/os-release; echo "${PRETTY_NAME:-Fedora}")" \
            || note "$(. /etc/os-release; echo "${PRETTY_NAME:-this system}") -- vela is only tested on Fedora"
    fi
    local version
    version="$(Hyprland --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1 || true)"
    if [ -z "$version" ]; then
        fail "Hyprland is not installed"
    elif [ "$(printf '%s\n%s\n' "$DOCTOR_HYPRLAND_MIN" "$version" | sort -V | head -1)" = "$DOCTOR_HYPRLAND_MIN" ]; then
        pass "Hyprland $version"
    else
        fail "Hyprland $version -- the config needs $DOCTOR_HYPRLAND_MIN or newer (the Lua config)"
    fi

    # What the desktop cannot come up without -- fish too, since kitty opens
    # it -- with the versions of quickshell and matugen, the two most likely
    # to be behind.
    local cmd pkg ver
    for cmd in qs:quickshell matugen:matugen hypridle:hypridle hyprlock:hyprlock kitty:kitty fish:fish stow:stow; do
        pkg="${cmd#*:}"; cmd="${cmd%%:*}"
        if ! command -v "$cmd" >/dev/null 2>&1; then
            fail "$pkg is not installed (sudo dnf install $pkg)"
            continue
        fi
        ver=""
        case "$cmd" in qs | matugen) ver="$("$cmd" --version 2>/dev/null | grep -oE '[0-9]+(\.[0-9]+)+' | head -1 || true)" ;; esac
        pass "$pkg${ver:+ $ver}"
    done
    # A matugen older than 4.0 cannot be told which colour to take. It still
    # themes, from the wallpaper's dominant colour (see cmd_retint), and
    # vela's own build (packaging/fedora) is the one that does it properly.
    if command -v matugen >/dev/null 2>&1 && ! matugen image --help 2>/dev/null | grep -q -- '--source-color-index'; then
        note "matugen is older than 4.0, so palettes come from the wallpaper's dominant colour. For vela's build: ${repo/#$HOME/\~}/bootstrap.sh --matugen"
    fi

    # What one feature each needs: missing costs that feature, nothing more.
    local missing=() entry
    for entry in \
        "brightnessctl:screen brightness" "playerctl:media keys" "cava:the music visualiser" \
        "khal:the calendar" "vdirsyncer:calendar sync" "secret-tool:calendar passwords" \
        "grim:screenshots" "slurp:picking a region" "wl-copy:the clipboard" "cliphist:clipboard history" \
        "wf-recorder:screen recording" "swappy:annotating screenshots" "tesseract:text from the screen" \
        "magick:wallpaper thumbnails" "hyprsunset:evening warmth" "fastfetch:the terminal greeting" \
        "wtype:typing emoji and clips" "fuzzel:the fallback launcher" "starship:the prompt"; do
        command -v "${entry%%:*}" >/dev/null 2>&1 || missing+=("${entry%%:*} (${entry#*:})")
    done
    if [ "${#missing[@]}" -eq 0 ]; then
        pass "every optional tool is there"
    else
        local m
        for m in "${missing[@]}"; do note "missing: $m"; done
    fi

    # The icons are a font: without it every glyph in the shell is a word.
    local families
    families="$(fc-list : family 2>/dev/null || true)"
    grep -q "Material Symbols Rounded" <<<"$families" && pass "Material Symbols Rounded (the icons)" \
        || fail "the Material Symbols Rounded font is missing -- every icon will show as text"
    grep -qE "JetBrainsMono Nerd Font|JetBrainsMono NF" <<<"$families" || note "missing font: JetBrainsMono Nerd Font (the prompt and figures)"
    grep -q "Rubik" <<<"$families" || note "missing font: Rubik (headings)"

    # The configs are links into the repo.
    local rel unlinked=()
    if [ -x "$repo/bootstrap.sh" ]; then
        while IFS= read -r rel; do
            # Resolving into the repo is what counts: a link of its own, or
            # inside a linked parent.
            if [ ! -e "$HOME/$rel" ] || [[ "$(readlink -f "$HOME/$rel")" != "$repo"/* ]]; then
                unlinked+=("~/$rel")
            fi
        done < <("$repo/bootstrap.sh" --targets)
        if [ "${#unlinked[@]}" -eq 0 ]; then
            pass "configs linked from $repo"
        else
            fail "not linked from the repo: ${unlinked[*]} (run $repo/bootstrap.sh --link)"
        fi
    fi
    # The folders that hold your own files too (bootstrap.sh's UNFOLDED) are
    # real ones. Linked whole, as an older install left them, your settings
    # and palette are written into the repo, and updates refuse to run.
    local whole=()
    for rel in .config/vela .config/hypr .config/kitty .config/fuzzel .config/fish; do
        [ -L "$HOME/$rel" ] && whole+=("~/$rel")
    done
    [ "${#whole[@]}" -eq 0 ] || fail "linked whole, as an older install left them: ${whole[*]} -- your files in them are in the repo. Run the installer again, or $repo/bootstrap.sh --link"
    [ -f "$HOME/.config/hypr/conf/local.lua" ] && note "~/.config/hypr/conf/local.lua overrides some settings on this machine"

    # The palette every config reads.
    if [ -f "$STATE_DIR/colours.json" ]; then
        pass "palette generated, from $(basename "$(current_wallpaper 2>/dev/null || echo "a wallpaper")")"
    else
        note "no palette yet: run vela wallpaper <image>"
    fi

    # Only meaningful from inside the session.
    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        shell_running && pass "the shell is running" || fail "the shell is not running (vela shell start)"
        pgrep -x hypridle >/dev/null && pass "hypridle is running" || note "hypridle is not running: nothing dims, locks or suspends on its own"
    else
        note "not inside Hyprland, so whether the shell is running was not checked"
    fi

    # A graphics card the open driver cannot run well.
    local dev
    for dev in /sys/bus/pci/devices/*; do
        [ "$(cat "$dev/vendor" 2>/dev/null)" = 0x10de ] || continue
        case "$(cat "$dev/class" 2>/dev/null)" in
            0x03*) modinfo nvidia >/dev/null 2>&1 || note "NVIDIA GPU without the NVIDIA driver: see https://vela.ijasmin.it/help/nvidia/"; break ;;
        esac
    done

    return "$bad"
}

# The calendar accounts added in Settings, Calendars, and everything made from
# them, in one folder only the user can read:
#
#   accounts.json       the accounts: provider, name, server, username
#   state.json          the same, each with its calendars and how its last
#                       sync went -- what the shell reads
#   vdirsyncer.conf     one vdirsyncer pair per account
#   khal-calendars.conf the calendar blocks the shell splices into its copy of
#                       the khal config (services/Calendar.qml)
#   data/<id>/          the synced events, one vdir per calendar
#
# A calendar link (Google's secret address, Outlook's published calendar, any
# .ics) is read-only and fetched whole on each sync; a CalDAV account (iCloud,
# Nextcloud, anything else that speaks it) brings every calendar it has.
#
# THE SECRETS ARE IN THE KEYRING, NOT IN THE FOLDER. A password, and a link
# (a secret address is as good as a password), is stored with secret-tool in
# the Secret Service -- gnome-keyring, which autostart.lua starts and the
# login screen unlocks -- encrypted with the login password. vdirsyncer reads
# it from there at sync time (`password.fetch`, `url.fetch`), so no file here
# ever holds one. With no keyring, accounts cannot be added: there is no
# falling back to writing the password down.
#
# EVENTS are written into a CalDAV account's calendars here, as .ics files in
# its local copy, and reach the server with the next sync. So an event made
# while the server is out of reach -- a Nextcloud at home, from a cafe -- is
# in the month at once, counted as waiting, and uploaded the next time a sync
# gets through. A link calendar is read-only and never written; nor is an
# event that repeats, whose one file is the whole series; nor a calendar the
# server says is read-only (Nextcloud's contact birthdays, a calendar shared
# with you to read).
CALENDAR_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/vela/calendar"

cmd_calendar() {
    VELA_CALENDAR_DIR="$CALENDAR_DIR" python3 - "$@" <<'PY'
import glob, hashlib, json, os, re, secrets, shutil, subprocess, sys, time
import xml.etree.ElementTree as ET

root = os.environ["VELA_CALENDAR_DIR"]
SERVICE = "vela-calendar"
accounts_path = os.path.join(root, "accounts.json")
state_path = os.path.join(root, "state.json")
vdir_conf = os.path.join(root, "vdirsyncer.conf")
khal_blocks = os.path.join(root, "khal-calendars.conf")
data_dir = os.path.join(root, "data")
status_dir = os.path.join(root, "status")

PROVIDERS = {
    "google": {"kind": "link", "label": "Google Calendar"},
    "outlook": {"kind": "link", "label": "Outlook"},
    "link": {"kind": "link", "label": "Calendar"},
    "icloud": {"kind": "caldav", "label": "iCloud", "url": "https://caldav.icloud.com/"},
    "nextcloud": {"kind": "caldav", "label": "Nextcloud"},
    "caldav": {"kind": "caldav", "label": "CalDAV"},
}


def die(msg):
    print(f"vela: {msg}", file=sys.stderr)
    sys.exit(1)


# The Secret Service, through secret-tool. Every item is filed under this
# command's service name, the account's id and which secret it is.
def keyring_problem():
    if not shutil.which("secret-tool"):
        return "secret-tool is not installed (sudo dnf install libsecret)"
    try:
        p = subprocess.run(["secret-tool", "lookup", "service", SERVICE, "account", "probe", "field", "probe"],
                           capture_output=True, text=True, timeout=15)
    except subprocess.TimeoutExpired:
        return "the keyring did not answer"
    # Found, or simply not there: either way something answered. A missing
    # keyring says so on stderr.
    if p.returncode == 0 or (p.returncode == 1 and not p.stderr.strip()):
        return ""
    return "no keyring is running: " + re.sub(r"^secret-tool:\s*", "", complaint(p.stderr), flags=re.I)


def secret_store(aid, field, value, label):
    try:
        # Long enough for a locked keyring to ask for its password.
        p = subprocess.run(["secret-tool", "store", "--label", label, "service", SERVICE, "account", aid, "field", field],
                           input=value, capture_output=True, text=True, timeout=120)
    except subprocess.TimeoutExpired:
        raise RuntimeError("the keyring did not answer")
    if p.returncode != 0:
        raise RuntimeError("the keyring refused it: " + re.sub(r"^secret-tool:\s*", "", complaint(p.stderr), flags=re.I))


def secret_clear(aid):
    if shutil.which("secret-tool"):
        subprocess.run(["secret-tool", "clear", "service", SERVICE, "account", aid], capture_output=True, timeout=30)


def fetch(aid, field):
    return ["command", "secret-tool", "lookup", "service", SERVICE, "account", aid, "field", field]


# Accounts written before the keyring kept their secrets in accounts.json.
# Moved across the first time anything needs the keyring anyway; if it cannot
# be reached the file is left as it was rather than losing them.
def migrate(accs):
    moved = False
    for a in accs:
        if "password" in a:
            secret_store(a["id"], "password", a["password"], f"vela calendar: {a['name']}")
            del a["password"]
            moved = True
        if a["kind"] == "link" and "url" in a:
            secret_store(a["id"], "url", a["url"], f"vela calendar link: {a['name']}")
            a["host"] = host_of(a["url"])
            del a["url"]
            moved = True
    if moved:
        save_accounts(accs)


def ensure_dir():
    os.makedirs(root, mode=0o700, exist_ok=True)
    os.chmod(root, 0o700)


def write_private(path, text):
    ensure_dir()
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def load_json(path, empty):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        return empty
    except Exception as e:
        die(f"{path} is unreadable: {e}")


def accounts():
    return load_json(accounts_path, {"accounts": []}).setdefault("accounts", [])


def save_accounts(accs):
    write_private(accounts_path, json.dumps({"accounts": accs}, indent=2) + "\n")


def host_of(url):
    rest = url.split("://", 1)[-1]
    return rest.split("/", 1)[0]


def normalise_url(provider, url):
    url = url.strip()
    if url.startswith("webcal://"):
        url = "https://" + url[len("webcal://"):]
    if url and "://" not in url:
        url = "https://" + url
    if provider == "nextcloud" and url and "/remote.php/dav" not in url:
        url = url.rstrip("/") + "/remote.php/dav/"
    return url


# vdirsyncer reads its values as JSON, so a password with a quote in it
# still comes out whole.
def q(value):
    return json.dumps(value)


def section(account):
    return hashlib.sha256(json.dumps(account, sort_keys=True).encode()).hexdigest()[:16]


def collections_of(account):
    path = os.path.join(data_dir, account["id"])
    out = []
    for sub in sorted(glob.glob(os.path.join(path, "*", ""))):
        name = ""
        try:
            with open(os.path.join(sub, "displayname")) as f:
                name = f.read().strip()
        except OSError:
            pass
        folder = sub.rstrip("/")
        out.append({"name": name or os.path.basename(folder), "path": folder, "collection": os.path.basename(folder)})
    return out


# ---- which calendars take events -------------------------------------------
#
# Not every calendar on a CalDAV account can be written to: Nextcloud's
# contact birthdays are made from the address book, a Deck board's from its
# cards, and a calendar someone shared with you to read is theirs. An event
# written into one is refused at the next sync -- and, refused, fails every
# sync after it. So the server is asked which (each calendar's
# current-user-privilege-set, three small requests on each sync), and the
# answer kept, for when it cannot be asked. Until it first answers,
# Nextcloud's own read-only calendars are known by name.
DAV, CALDAV = "{DAV:}", "{urn:ietf:params:xml:ns:caldav}"


def known_readonly(collection):
    return collection == "contact_birthdays" or collection.startswith("app-generated--")


def readonly_of(account, status):
    ro = status.get(account["id"], {}).get("readonly")
    if ro is not None:
        return set(ro)
    return {c["collection"] for c in collections_of(account) if known_readonly(c["collection"])}


def writable_of(account, status):
    if account["kind"] != "caldav":
        return []
    ro = readonly_of(account, status)
    return [c for c in collections_of(account) if c["collection"] not in ro]


def password_of(aid):
    p = subprocess.run(["secret-tool", "lookup", "service", SERVICE, "account", aid, "field", "password"],
                       capture_output=True, text=True, timeout=120)
    if p.returncode != 0:
        raise RuntimeError("the keyring did not give the password")
    return p.stdout


def propfind(url, auth, props, depth):
    import urllib.error, urllib.request
    body = ('<?xml version="1.0" encoding="utf-8"?><d:propfind xmlns:d="DAV:" '
            'xmlns:c="urn:ietf:params:xml:ns:caldav"><d:prop>' + props + "</d:prop></d:propfind>")
    # urllib follows a redirect only for GET; a server that moves its DAV
    # root (a well-known URL) is followed here, a few times at most.
    for _ in range(4):
        req = urllib.request.Request(url, data=body.encode(), method="PROPFIND", headers={
            "Depth": depth, "Content-Type": "application/xml; charset=utf-8", "Authorization": auth})
        try:
            with urllib.request.urlopen(req, timeout=20) as r:
                return r.geturl(), ET.fromstring(r.read())
        except urllib.error.HTTPError as e:
            if e.code in (301, 302, 307, 308) and e.headers.get("Location"):
                from urllib.parse import urljoin
                url = urljoin(url, e.headers["Location"])
                continue
            raise
    raise RuntimeError("too many redirects")


# {href: {property: element}}, from each response's successful properties.
def responses(tree):
    out = {}
    for resp in tree.iter(DAV + "response"):
        found = {}
        for ps in resp.findall(DAV + "propstat"):
            if " 200 " not in (ps.findtext(DAV + "status") or "") + " ":
                continue
            for prop in ps.findall(DAV + "prop"):
                for child in prop:
                    found[child.tag] = child
        out[(resp.findtext(DAV + "href") or "").strip()] = found
    return out


def first_href(tree, prop):
    for found in responses(tree).values():
        el = found.get(prop)
        href = el.findtext(DAV + "href") if el is not None else None
        if href:
            return href.strip()
    return None


# {collection: takes events} for every calendar the server has, by the same
# name vdirsyncer gives its folder (the last part of its address).
def calendar_rights(account):
    import base64
    from urllib.parse import unquote, urljoin, urlparse
    token = base64.b64encode(f"{account['username']}:{password_of(account['id'])}".encode()).decode()
    auth = "Basic " + token
    # Where the account says, or, as vdirsyncer does when that is not it,
    # the server's well-known address and then its root.
    principal = None
    for start in (account["url"], urljoin(account["url"], "/.well-known/caldav"), urljoin(account["url"], "/")):
        try:
            url, tree = propfind(start, auth, "<d:current-user-principal/>", "0")
        except Exception as e:
            if unreachable(str(e)):
                raise
            continue
        principal = first_href(tree, DAV + "current-user-principal")
        if principal:
            break
    if not principal:
        raise RuntimeError("the server did not say whose calendars these are")
    url, tree = propfind(urljoin(url, principal), auth, "<c:calendar-home-set/>", "0")
    home = first_href(tree, CALDAV + "calendar-home-set")
    if not home:
        raise RuntimeError("the server did not say where the calendars are")
    url, tree = propfind(urljoin(url, home), auth, "<d:resourcetype/><d:current-user-privilege-set/>", "1")
    out = {}
    for href, found in responses(tree).items():
        kind = found.get(DAV + "resourcetype")
        if kind is None or kind.find(CALDAV + "calendar") is None:
            continue
        name = unquote(urlparse(href).path.rstrip("/").rsplit("/", 1)[-1])
        privs = found.get(DAV + "current-user-privilege-set")
        if privs is None:
            # Not said: taken as writable, unless it is known not to be.
            out[name] = not known_readonly(name)
            continue
        have = {c.tag for p in privs.findall(DAV + "privilege") for c in p}
        out[name] = bool(have & {DAV + "all", DAV + "write", DAV + "bind", DAV + "write-content"})
    return out


def is_made_here(path):
    try:
        with open(path, encoding="utf-8") as f:
            return any(line.startswith("UID:") and line.strip().endswith("@vela") for line in f)
    except OSError:
        return False


# A calendar newly known to be read-only may hold what was written into it
# before anyone knew: an event made here, which the server will never take,
# or one of its own changed or deleted, which it will never let go. The
# events made here move to the account's first calendar that takes them (so
# they are kept, and uploaded there), and the rest of the local copy is
# started afresh from the server.
def settle_readonly(account, collections, st):
    home = next((c for c in writable_of(account, {account["id"]: st})), None)
    moved = 0
    for name in collections:
        folder = os.path.join(data_dir, account["id"], name)
        for f in glob.glob(os.path.join(folder, "*.ics")):
            if is_made_here(f) and home:
                os.replace(f, os.path.join(home["path"], os.path.basename(f)))
                moved += 1
            else:
                os.remove(f)
        items = os.path.join(status_dir, f"acc_{account['id']}", f"{name}.items")
        if os.path.exists(items):
            os.remove(items)
    if moved:
        st["pending"] = st.get("pending", 0) + moved


def calendars_of(account):
    if account["kind"] == "link":
        return [account["name"]]
    return [c["name"] for c in collections_of(account)]


def write_configs(accs):
    ensure_dir()
    if not accs:
        for path in (vdir_conf, khal_blocks):
            if os.path.exists(path):
                os.remove(path)
        return
    conf = ["[general]", f"status_path = {q(status_dir + '/')}", ""]
    blocks = []
    used = set()
    for a in accs:
        pair = f"acc_{a['id']}"
        path = os.path.join(data_dir, a["id"])
        os.makedirs(path, exist_ok=True)
        conf += [f"[pair {pair}]", f"a = {q(pair + '_remote')}", f"b = {q(pair + '_local')}"]
        if a["kind"] == "link":
            conf += ["collections = null", 'conflict_resolution = "a wins"', ""]
            conf += [f"[storage {pair}_remote]", 'type = "http"', f"url.fetch = {q(fetch(a['id'], 'url'))}", ""]
        else:
            conf += ['collections = ["from a"]', 'conflict_resolution = "a wins"', 'metadata = ["displayname", "color"]', ""]
            conf += [f"[storage {pair}_remote]", 'type = "caldav"', f"url = {q(a['url'])}",
                     f"username = {q(a['username'])}", f"password.fetch = {q(fetch(a['id'], 'password'))}", ""]
        conf += [f"[storage {pair}_local]", 'type = "filesystem"', f"path = {q(path + '/')}", 'fileext = ".ics"', ""]
        if a["kind"] == "link":
            # khal's name for it is the account's: brackets would end the
            # section header, and two with one name would be one section.
            name = "".join(c for c in a["name"] if c not in "[]\n").strip() or "Calendar"
            base, n = name, 2
            while name.lower() in used:
                name, n = f"{base} {n}", n + 1
            used.add(name.lower())
            blocks += [f"[[{name}]]", f'path = "{path}/"', "readonly = True", ""]
        else:
            # Each calendar the account has, named by its own display name.
            blocks += [f"[[{pair}]]", f'path = "{path}/*"', "type = discover", ""]
    write_private(vdir_conf, "\n".join(conf))
    write_private(khal_blocks, "\n".join(blocks))


def write_state(accs, status):
    out = []
    for a in accs:
        st = status.get(a["id"], {})
        out.append({
            "id": a["id"],
            "provider": a["provider"],
            "kind": a["kind"],
            "name": a["name"],
            "host": a.get("host") or host_of(a.get("url", "")),
            "username": a.get("username", ""),
            "calendars": calendars_of(a),
            # The calendars events can be written to: a CalDAV account's,
            # but for those the server keeps read-only.
            "writable": [{"name": c["name"], "path": c["path"]} for c in writable_of(a, status)],
            "ok": st.get("ok"),
            "error": st.get("error", ""),
            "offline": st.get("offline", False),
            "pending": st.get("pending", 0),
            "synced": st.get("synced", 0),
            "discovered": st.get("discovered", ""),
        })
    status = {a["id"]: status[a["id"]] for a in accs if a["id"] in status}
    write_private(state_path, json.dumps({"accounts": out, "status": status}, indent=2) + "\n")


def status_map():
    return load_json(state_path, {}).get("status", {})


# The line of vdirsyncer's complaint worth showing: its first error, without
# the label.
def complaint(text):
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    found = lines[-1] if lines else "failed"
    for l in lines:
        low = l.lower()
        hit = next((label for label in ("critical:", "error:") if low.startswith(label)), None)
        if hit:
            found = l[len(hit):].strip()
            break
    # vdirsyncer names the pair it was working on, which is this command's
    # business, not the reader's.
    found = re.sub(r"^Unknown error occurred for acc_[0-9a-f]+\S*:\s*", "", found)
    found = re.sub(r"\s*\bacc_[0-9a-f]+(_remote|_local)?\b", "", found)
    # vdirsyncer asks secret-tool for each account's secret, and when the
    # keyring gives nothing back -- locked, or a keyring that never had it --
    # it prints the whole command it ran.
    asked = re.search(r"\['secret-tool', 'lookup'.*'field', '(\w+)'\]' returned non-zero", found)
    if asked:
        what = "link" if asked.group(1) == "url" else "password"
        found = f"the keyring did not give its {what}. Unlock the keyring; if it is unlocked, remove the account and add it again"
    return found[:1].upper() + found[1:]


UNREACHABLE = ("cannot connect to host", "name or service not known", "temporary failure in name resolution",
               "connection refused", "network is unreachable", "no route to host", "timed out", "timeout",
               "server disconnected", "getaddrinfo", "connection reset", "clientconnectorerror")


def unreachable(text):
    low = text.lower()
    # The keyring's own "Connection refused" (no keyring running) is not the
    # server being out of reach, and is not to be told as such.
    if "keyring" in low or "secret-tool" in low:
        return False
    return any(k in low for k in UNREACHABLE)


def run(args, answer=""):
    try:
        p = subprocess.run(args, input=answer, capture_output=True, text=True, timeout=180)
    except subprocess.TimeoutExpired:
        raise RuntimeError("timed out")
    if p.returncode != 0:
        raise RuntimeError(complaint(p.stderr + "\n" + p.stdout))


def cmd_add():
    env = os.environ
    provider = env.get("VELA_CAL_PROVIDER", "").strip().lower()
    if provider not in PROVIDERS:
        die(f"unknown provider: {provider or '(none)'} (one of {', '.join(PROVIDERS)})")
    kind = PROVIDERS[provider]["kind"]
    url = normalise_url(provider, env.get("VELA_CAL_URL", "") or PROVIDERS[provider].get("url", ""))
    if not url.startswith(("http://", "https://")) or not host_of(url):
        die("that is not a link")
    account = {
        "id": secrets.token_hex(4),
        "provider": provider,
        "kind": kind,
        "name": env.get("VELA_CAL_NAME", "").strip() or PROVIDERS[provider]["label"],
        "host": host_of(url),
    }
    user, password = env.get("VELA_CAL_USER", "").strip(), env.get("VELA_CAL_PASS", "")
    if kind == "caldav" and (not user or not password):
        die("a CalDAV account needs a username and a password")
    problem = keyring_problem()
    if problem:
        die(problem)
    accs = accounts()
    try:
        migrate(accs)
        if kind == "link":
            secret_store(account["id"], "url", url, f"vela calendar link: {account['name']}")
        else:
            account["url"], account["username"] = url, user
            secret_store(account["id"], "password", password, f"vela calendar: {account['name']}")
    except RuntimeError as e:
        secret_clear(account["id"])
        die(str(e))
    accs.append(account)
    save_accounts(accs)
    write_configs(accs)
    write_state(accs, status_map())
    print(account["id"])


def cmd_remove(aid):
    accs = accounts()
    left = [a for a in accs if a["id"] != aid]
    if len(left) == len(accs):
        die(f"no account {aid}")
    save_accounts(left)
    secret_clear(aid)
    shutil.rmtree(os.path.join(data_dir, aid), ignore_errors=True)
    for f in glob.glob(os.path.join(status_dir, f"acc_{aid}*")):
        shutil.rmtree(f, ignore_errors=True) if os.path.isdir(f) else os.remove(f)
    write_configs(left)
    status = status_map()
    status.pop(aid, None)
    write_state(left, status)


def cmd_sync(only):
    accs = accounts()
    # Every account's secret is in the keyring, so without one nothing can
    # sync -- said once, plainly, rather than as vdirsyncer's complaint about
    # a command that failed.
    problem = keyring_problem() if accs else ""
    if not problem:
        try:
            migrate(accs)
        except RuntimeError as e:
            problem = str(e)
    write_configs(accs)
    status = status_map()
    chosen = [a for a in accs if not only or a["id"] == only]
    if only and not chosen:
        die(f"no account {only}")
    failed = []
    have = shutil.which("vdirsyncer") is not None
    for a in chosen:
        st = status.setdefault(a["id"], {})
        pair = f"acc_{a['id']}"
        try:
            if problem:
                raise RuntimeError(problem[:1].upper() + problem[1:])
            if not have:
                raise RuntimeError("vdirsyncer is not installed")
            # Discovery once per account (and again if it changes): it asks
            # the server which calendars there are, and says yes to making
            # a local copy of each.
            rights = None
            if a["kind"] == "caldav":
                try:
                    rights = calendar_rights(a)
                except Exception as e:
                    # Out of reach, or a server that will not say: the last
                    # answer stands, and the sync below says what is wrong.
                    if unreachable(str(e)):
                        raise RuntimeError(str(e))
            # A calendar the server has and this copy does not (made since,
            # on the phone or the web) is discovered too.
            have_here = {c["collection"] for c in collections_of(a)}
            new_there = rights is not None and any(n not in have_here for n in rights)
            if st.get("discovered") != section(a) or new_there:
                run(["vdirsyncer", "-c", vdir_conf, "discover", pair], "y\n" * 64)
                if a["kind"] == "caldav":
                    run(["vdirsyncer", "-c", vdir_conf, "metasync", pair])
                st["discovered"] = section(a)
            if rights is not None:
                ro = sorted(n for n, w in rights.items() if not w)
                known = st.get("readonly")
                before = set(known) if known is not None else set()
                fresh = [n for n in ro if n not in before]
                st["readonly"] = ro
                if fresh:
                    settle_readonly(a, fresh, st)
            run(["vdirsyncer", "-c", vdir_conf, "sync", pair])
            # Everything written here has reached the server now.
            st.update(ok=True, error="", offline=False, pending=0, synced=int(time.time()))
        except RuntimeError as e:
            # Out of reach is not broken: a server at home, a laptop out.
            # Said as such, and what was written meanwhile keeps waiting.
            offline = unreachable(str(e))
            host = a.get("host") or host_of(a.get("url", ""))
            st.update(ok=False, offline=offline, error=f"Can't reach {host}" if offline else str(e))
            failed.append(f"{a['name']}: {st['error']}")
    write_state(accs, status)
    # A vdirsyncer set up by hand is synced too, so this can be the one sync
    # command in shell.json either way.
    own = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "vdirsyncer", "config")
    if not only and have and os.path.exists(own):
        try:
            run(["vdirsyncer", "sync"])
        except RuntimeError as e:
            failed.append(f"vdirsyncer: {e}")
    if failed:
        die(failed[0])


def cmd_list():
    accs = accounts()
    status = status_map()
    if not accs:
        print("No calendar accounts. Add one in Settings, Calendars.")
        return
    for a in accs:
        st = status.get(a["id"], {})
        how = "synced" if st.get("ok") else (st.get("error") or "not synced yet")
        print(f"{a['id']}  {a['provider']:<9}  {a['name']}  ({a.get('host') or host_of(a.get('url', ''))})  {how}")
        for c in calendars_of(a):
            print(f"          - {c}")


# ---- events --------------------------------------------------------------
#
# From the environment, like `add`: VELA_EV_PATH (the calendar: one of an
# account's `writable` paths), VELA_EV_TITLE, VELA_EV_START and VELA_EV_END
# ("2026-09-28T15:00" in local time, or "2026-09-28" for an all-day event,
# END inclusive) and VELA_EV_LOCATION. Timed events are written in UTC, which
# every client reads the same wherever it is; all-day ones as dates.
def ical():
    try:
        import icalendar
        return icalendar
    except ImportError:
        die("python3-icalendar is not installed (sudo dnf install python3-icalendar)")


def writable_paths(accs, status=None):
    status = status_map() if status is None else status
    return {c["path"]: a for a in accs for c in writable_of(a, status)}


def find_event(accs, uid):
    for path, account in writable_paths(accs).items():
        for f in glob.glob(os.path.join(path, "*.ics")):
            try:
                with open(f, encoding="utf-8") as fh:
                    text = fh.read()
            except OSError:
                continue
            if any(line.strip() == f"UID:{uid}" for line in text.splitlines()):
                return f, account
    return None, None


def event_times():
    from datetime import date, datetime, timedelta, timezone
    start, end = os.environ.get("VELA_EV_START", "").strip(), os.environ.get("VELA_EV_END", "").strip()
    try:
        if "T" not in start:
            first = date.fromisoformat(start)
            last = date.fromisoformat(end) if end else first
            if last < first:
                die("the event ends before it starts")
            return first, last + timedelta(days=1)
        # A naive time is the machine's own zone; astimezone() says which.
        s = datetime.fromisoformat(start).astimezone().astimezone(timezone.utc)
        e = datetime.fromisoformat(end).astimezone().astimezone(timezone.utc) if end else s + timedelta(hours=1)
    except ValueError:
        die(f"not a time: {start} {end}")
    if e <= s:
        die("the event ends before it starts")
    return s, e


def write_ics(path, cal):
    tmp = path + ".tmp"
    with open(tmp, "wb") as f:
        f.write(cal.to_ical())
    os.replace(tmp, path)


def mark_pending(account, status):
    st = status.setdefault(account["id"], {})
    st["pending"] = st.get("pending", 0) + 1


def fill(event, title, start, end, location):
    from datetime import datetime, timezone
    now = datetime.now(timezone.utc)
    for key in ("summary", "dtstart", "dtend", "duration", "location", "dtstamp", "last-modified"):
        if key in event:
            del event[key]
    event.add("summary", title)
    event.add("dtstart", start)
    event.add("dtend", end)
    if location:
        event.add("location", location)
    event.add("dtstamp", now)
    event.add("last-modified", now)


def cmd_event_add():
    import uuid
    from datetime import datetime, timezone
    icalendar = ical()
    accs = accounts()
    target = os.environ.get("VELA_EV_PATH", "")
    account = writable_paths(accs).get(target)
    if not account:
        die("that calendar can't be written to")
    title = os.environ.get("VELA_EV_TITLE", "").strip() or "New event"
    start, end = event_times()
    uid = f"{uuid.uuid4()}@vela"
    cal = icalendar.Calendar()
    cal.add("prodid", "-//vela//calendar//EN")
    cal.add("version", "2.0")
    event = icalendar.Event()
    event.add("uid", uid)
    event.add("created", datetime.now(timezone.utc))
    event.add("sequence", 0)
    fill(event, title, start, end, os.environ.get("VELA_EV_LOCATION", "").strip())
    cal.add_component(event)
    write_ics(os.path.join(target, f"{uid.split('@')[0]}.ics"), cal)
    status = status_map()
    mark_pending(account, status)
    write_state(accs, status)
    print(uid)


def open_event(accs, uid):
    icalendar = ical()
    path, account = find_event(accs, uid)
    if not path:
        die("that event is not in a calendar that can be written to")
    with open(path, "rb") as f:
        cal = icalendar.Calendar.from_ical(f.read())
    events = [c for c in cal.walk("VEVENT") if str(c.get("uid", "")) == uid]
    if not events:
        die("that event is not in its file")
    if any("rrule" in e or "recurrence-id" in e for e in events):
        die("it repeats: change it in your calendar app, where the whole series can be seen")
    return path, account, cal, events[0]


def cmd_event_edit(uid):
    accs = accounts()
    path, account, cal, event = open_event(accs, uid)
    target = os.environ.get("VELA_EV_PATH", "") or os.path.dirname(path)
    moving_to = writable_paths(accs).get(target)
    if not moving_to:
        die("that calendar can't be written to")
    start, end = event_times()
    fill(event, os.environ.get("VELA_EV_TITLE", "").strip() or str(event.get("summary", "")), start, end,
         os.environ.get("VELA_EV_LOCATION", "").strip())
    seq = int(event.get("sequence", 0)) + 1
    if "sequence" in event:
        del event["sequence"]
    event.add("sequence", seq)
    status = status_map()
    if os.path.dirname(path) == target.rstrip("/"):
        write_ics(path, cal)
    else:
        # Another calendar: written there, taken out of here. The next sync
        # uploads it to the one and deletes it from the other.
        write_ics(os.path.join(target, os.path.basename(path)), cal)
        os.remove(path)
        mark_pending(moving_to, status)
    mark_pending(account, status)
    write_state(accs, status)


def cmd_event_delete(uid):
    accs = accounts()
    path, account, _cal, _event = open_event(accs, uid)
    os.remove(path)
    status = status_map()
    mark_pending(account, status)
    write_state(accs, status)


args = sys.argv[1:]
cmd = args[0] if args else "list"
if cmd == "list":
    cmd_list()
elif cmd == "add":
    cmd_add()
elif cmd == "remove" and len(args) == 2:
    cmd_remove(args[1])
elif cmd == "sync":
    cmd_sync(args[1] if len(args) > 1 else "")
elif cmd == "event" and len(args) >= 2 and args[1] == "add":
    cmd_event_add()
elif cmd == "event" and len(args) == 3 and args[1] == "edit":
    cmd_event_edit(args[2])
elif cmd == "event" and len(args) == 3 and args[1] == "delete":
    cmd_event_delete(args[2])
elif cmd == "keyring":
    problem = keyring_problem()
    print(problem or "ok")
    sys.exit(1 if problem else 0)
else:
    die("usage: vela calendar [list|add|sync [id]|remove <id>|keyring|event add|event edit <uid>|event delete <uid>]")
PY
}

# AI tools: how much of a Claude Code or Codex plan is used, and what each
# session is doing, for the System tab's cards and the bar's pill. vela never
# reads a login or asks a server anything; it reads what the tools already hand
# out:
#
#   Claude Code  runs `vela ai statusline` as its status line, with its plan's
#                5-hour and weekly windows, the model and its effort in the
#                JSON on stdin (documented at code.claude.com/docs/en/statusline).
#                They go to ai/claude.json, and a status line the user already
#                had is run after it with the same input, so theirs keeps
#                working. The rest of /usage -- a model's own weekly limit,
#                Fable's -- comes from asking Claude Code (`claude-usage`).
#   Codex        writes its plan's windows into its own session files after
#                every reply (token_count events under ~/.codex/sessions);
#                `status` reads the newest one. Nothing to set up.
#   Both         run `vela ai hook <tool>` from their hooks, if connected, for
#                "working", "needs you" and "done". Kept in the runtime dir: a
#                session does not outlive a reboot.
#
# `connect` and `disconnect` add and remove only vela's own entries, and save
# the file as it was first (settings.json.vela-backup, hooks.json.vela-backup).
AI_STATE_DIR="$STATE_DIR/ai"

cmd_ai() {
    local bin="$HOME/.local/bin/vela"
    [ -x "$bin" ] || bin="$(command -v vela 2>/dev/null || readlink -f "$0")"
    # -c rather than a heredoc: statusline and hook read the tool's JSON on
    # stdin, which a heredoc would take.
    VELA_AI_STATE="$AI_STATE_DIR" VELA_AI_BIN="$bin" python3 -c "$VELA_AI_PY" "$@"
}

read -r -d '' VELA_AI_PY <<'PY' || true
import contextlib, fcntl, json, os, shlex, shutil, subprocess, sys, time
from datetime import datetime

HOME = os.path.expanduser("~")
STATE = os.environ["VELA_AI_STATE"]
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or STATE
LIVE = os.path.join(RUNTIME, "vela-ai-live.json")
VELA = os.environ["VELA_AI_BIN"]
CLAUDE_DIR = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(HOME, ".claude")
CODEX_DIR = os.environ.get("CODEX_HOME") or os.path.join(HOME, ".codex")
CLAUDE_SETTINGS = os.path.join(CLAUDE_DIR, "settings.json")
CODEX_HOOKS = os.path.join(CODEX_DIR, "hooks.json")
CLAUDE_USAGE = os.path.join(STATE, "claude.json")
# The full /usage numbers, asked of Claude Code itself (`claude-usage`).
CLAUDE_PLAN = os.path.join(STATE, "claude-usage.json")
# The tools' logos, as path data the shell draws in the palette's colours.
ICONS = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share"), "vela/icons")
# Not kept in this repo: they are Anthropic's and OpenAI's marks. theSVG's
# single-colour versions, pinned to one commit and checked.
ICON_BASE = "https://raw.githubusercontent.com/glincker/thesvg/d8747c36ca3ca41b53a9478012e6b89bb9f406d0/public/icons"
ICON_SOURCES = {
    "claude": (f"{ICON_BASE}/claude-code/mono.svg", "dc0c501131ef33da534fac1090a85901b9f5d67e97bfa1ac8a067423c04f5c6c"),
    "codex": (f"{ICON_BASE}/codex/default.svg", "627cd8b8108038310b98b0bd35f244ee7422b7c0a08355f6beeead1ad0cd457e"),
}
# The status line the user had before vela's, run after vela's.
CLAUDE_PREVIOUS = os.path.join(STATE, "claude-statusline.json")
MARK_STATUS = "ai statusline"
MARK_HOOK = "ai hook"

# Hook event -> what the session is doing. Stop and done: the shell shows
# "done" for a moment and then nothing. A tool the user approved shows up as
# PostToolUse, which is how "needs you" goes back to "working".
STATES = {
    "SessionStart": "idle",
    "UserPromptSubmit": "working",
    "PermissionRequest": "need",
    "PostToolUse": "working",
    "Stop": "done",
    "StopFailure": "done",
    "SessionEnd": "end",
}
CLAUDE_EVENTS = ["SessionStart", "UserPromptSubmit", "PermissionRequest", "PostToolUse", "Stop", "StopFailure", "SessionEnd"]
CODEX_EVENTS = ["SessionStart", "UserPromptSubmit", "PermissionRequest", "PostToolUse", "Stop", "SessionEnd"]
# Codex's background servers, which are not a session: the app-server daemon
# the TUI starts and leaves running (and its updater, `app-server daemon`),
# the app-server an editor runs, the MCP and exec servers.
SERVERS = {"app-server", "mcp-server", "exec-server", "stdio-to-uds", "responses-api-proxy"}
# The ChatGPT app for Linux (/usr/lib/chatgpt/ChatGPT), as /proc names it.
DESKTOP = "ChatGPT"


def die(msg):
    print(f"vela: {msg}", file=sys.stderr)
    sys.exit(1)


def read_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def read_settings(path):
    """A tool's own settings file: missing is empty, unreadable is an error
    (vela never writes over a file it could not parse)."""
    if not os.path.exists(path):
        return {}
    try:
        with open(path) as f:
            data = json.load(f)
    except ValueError as e:
        die(f"{path} is not valid JSON ({e}); not touching it")
    if not isinstance(data, dict):
        die(f"{path} is not a JSON object; not touching it")
    return data


def write_json(path, data, indent=None):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.vela-tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=indent)
        f.write("\n")
    if os.path.exists(path):
        shutil.copymode(path, tmp)
    os.replace(tmp, path)


def backup(path):
    if os.path.exists(path):
        shutil.copy2(path, f"{path}.vela-backup")


def ts(value):
    if isinstance(value, (int, float)):
        return int(value)
    try:
        return int(datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp())
    except ValueError:
        return 0


@contextlib.contextmanager
def live_file():
    """The live sessions, read and written under a lock: two tools, or two
    sessions of one, can fire hooks at the same moment."""
    os.makedirs(os.path.dirname(LIVE), exist_ok=True)
    with open(f"{LIVE}.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        data = read_json(LIVE, {}) or {}
        data.setdefault("sessions", {})
        before = json.dumps(data, sort_keys=True)
        yield data
        # Written once even when empty: the shell watches it for changes.
        if json.dumps(data, sort_keys=True) != before or not os.path.exists(LIVE):
            write_json(LIVE, data)


def parent_of(pid):
    try:
        with open(f"/proc/{pid}/stat") as f:
            return int(f.read().rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError, IndexError):
        return 0


def comm_of(pid):
    try:
        with open(f"/proc/{pid}/comm") as f:
            return f.read().strip()
    except OSError:
        return ""


def cmdline_of(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return f.read().replace(b"\0", b" ").decode(errors="replace")
    except OSError:
        return ""


def started(pid):
    """When the process started, in clock ticks since boot."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            return int(f.read().rsplit(")", 1)[1].split()[19])
    except (OSError, ValueError, IndexError):
        return 0


def is_tool(pid, tool):
    comm = comm_of(pid)
    if comm == tool or comm.startswith(f"{tool}-"):
        return True
    # Installed with npm: node running the package.
    return comm == "node" and ("claude-code" if tool == "claude" else "@openai/codex") in cmdline_of(pid)


def args_of(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return f.read().decode(errors="replace").split("\0")
    except OSError:
        return []


def is_server(pid):
    return not SERVERS.isdisjoint(args_of(pid)[1:])


def workdir(pid, tool):
    """The folder a session works in: where it was started, or for Codex the
    one -C or --cd names."""
    try:
        here = os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return ""
    args = args_of(pid) if tool == "codex" else []
    for i, arg in enumerate(args):
        if arg in ("-C", "--cd") and i + 1 < len(args):
            return os.path.normpath(os.path.join(here, args[i + 1]))
        if arg.startswith("--cd="):
            return os.path.normpath(os.path.join(here, arg[5:]))
    return here


def desktop_of(server):
    """The ChatGPT app a Codex server runs under, or 0. The app for Linux runs
    Codex as an app-server of its own, and a session there is the app's."""
    host = parent_of(server)
    return host if comm_of(host) == DESKTOP else 0


def session_pid(tool, chain, cwd):
    """The session a hook comes from: the tool above it. Codex's TUI runs its
    sessions in the app-server daemon it starts, and the hooks with them, but
    the daemon outlives the TUI and fires no SessionEnd when you quit, and
    what is above it is only whichever TUI happened to start it. So a hook
    under the daemon belongs to the Codex open in the session's folder -- and
    one under the ChatGPT app's own server, to the app."""
    first = next((p for p in chain if is_tool(p, tool)), 0)
    if not first or not is_server(first):
        return first or (chain[0] if chain else 0)
    app = desktop_of(first)
    if app:
        return app
    real = os.path.realpath(cwd) if cwd else ""
    same = [s for s in processes()[tool] if real and os.path.realpath(s["cwd"]) == real]
    return max(same, key=lambda s: started(s["pid"]))["pid"] if same else 0


def ancestry(pid):
    chain = []
    while pid > 1 and len(chain) < 24:
        chain.append(pid)
        pid = parent_of(pid)
    return chain


def alive(pid):
    """Running, and not a zombie: one that has exited but not been reaped."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            return pid > 0 and f.read().rsplit(")", 1)[1].split()[0] != "Z"
    except (OSError, IndexError):
        return False


# ---- Claude Code's status line ----------------------------------------------
def statusline():
    raw = sys.stdin.buffer.read()
    try:
        data = json.loads(raw or b"{}")
    except ValueError:
        data = {}
    windows = {}
    # Every window Claude Code reports, not only the two known today: one it
    # adds later (a model's own weekly share, say) shows up without a change.
    for key, window in (data.get("rate_limits") or {}).items():
        if isinstance(window, dict) and "used_percentage" in window:
            windows[key] = {"used": float(window.get("used_percentage") or 0), "resetsAt": int(window.get("resets_at") or 0)}
    model = data.get("model") or {}
    context = (data.get("context_window") or {}).get("used_percentage")
    # Only a reply carries the windows, and an API-key session never does:
    # without them the last known numbers stay.
    if windows:
        write_json(CLAUDE_USAGE, {
            "updated": int(time.time()),
            "model": model.get("display_name") or model.get("id") or "",
            "modelId": model.get("id") or "",
            "cwd": (data.get("workspace") or {}).get("current_dir") or data.get("cwd") or "",
            "context": context,
            # Absent for a model without the effort setting.
            "effort": (data.get("effort") or {}).get("level") or "",
            "fast": bool(data.get("fast_mode")),
            "windows": windows,
        })
    previous = read_json(CLAUDE_PREVIOUS)
    if isinstance(previous, dict) and previous.get("command"):
        try:
            done = subprocess.run(previous["command"], shell=True, input=raw, capture_output=True, timeout=10)
            sys.stdout.buffer.write(done.stdout)
        except subprocess.TimeoutExpired:
            pass
        return
    parts = [model.get("display_name") or ""]
    if context is not None:
        parts.append(f"context {round(context)}%")
    if "five_hour" in windows:
        parts.append(f"5h {round(windows['five_hour']['used'])}%")
    if "seven_day" in windows:
        parts.append(f"week {round(windows['seven_day']['used'])}%")
    print(" · ".join(p for p in parts if p))


# ---- Claude Code's /usage --------------------------------------------------------
def claude_usage():
    """What /usage shows, from Claude Code itself: its `get_usage` request,
    which it describes as for "a usage meter". The status line carries only
    the 5-hour and weekly windows; this has the rest -- a model's own weekly
    limit (Fable's), Sonnet's -- and the plan. Claude Code is run once,
    headless, with no session saved, no hooks and no MCP servers, and asked
    nothing else: no message goes to a model. Experimental in Claude Code, so
    anything unexpected leaves the last numbers as they were."""
    exe = which("claude")
    if not exe:
        die("claude is not installed")
    request = {"type": "control_request", "request_id": "vela-usage", "request": {"subtype": "get_usage", "skip_behaviors": True}}
    command = [exe, "-p", "--input-format", "stream-json", "--output-format", "stream-json", "--verbose",
               "--no-session-persistence", "--strict-mcp-config", "--disable-slash-commands",
               "--settings", json.dumps({"disableAllHooks": True})]
    try:
        done = subprocess.run(command, input=(json.dumps(request) + "\n").encode(), capture_output=True, timeout=60, cwd=HOME)
    except (OSError, subprocess.TimeoutExpired) as e:
        die(f"claude did not answer ({e})")
    answer = None
    for line in done.stdout.splitlines():
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        response = msg.get("response") or {}
        if msg.get("type") == "control_response" and response.get("request_id") == "vela-usage":
            if response.get("subtype") != "success":
                die(f"claude: {response.get('error') or 'get_usage failed'}")
            answer = response.get("response") or {}
    if answer is None:
        die("claude gave no usage answer")
    limits = answer.get("rate_limits") if answer.get("rate_limits_available") else None
    windows = {}
    if isinstance(limits, dict):
        for key in ("five_hour", "seven_day", "seven_day_sonnet", "seven_day_opus"):
            w = limits.get(key)
            if isinstance(w, dict) and w.get("utilization") is not None:
                windows[key] = {"used": float(w["utilization"]), "resetsAt": ts(w.get("resets_at"))}
        for w in limits.get("model_scoped") or []:
            if isinstance(w, dict) and w.get("utilization") is not None and w.get("display_name"):
                windows[f"model:{w['display_name']}"] = {"used": float(w["utilization"]), "resetsAt": ts(w.get("resets_at"))}
    write_json(CLAUDE_PLAN, {
        "updated": int(time.time()),
        "available": bool(windows),
        "plan": answer.get("subscription_type") or "",
        "windows": windows,
    })


# ---- the tools' icons -------------------------------------------------------------
def spaced_path(d):
    """SVG path data with every number set apart. Minified paths pack an
    arc's two flags into the next number ("a6 6 0 013.04-.41" is flags 0 and
    1, then 3.04), which Qt's path parser reads as one number and draws a
    tangle; here each flag is read as the single digit it is."""
    import re
    number = re.compile(r"[+-]?(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?")
    counts = {"m": 2, "l": 2, "h": 1, "v": 1, "c": 6, "s": 4, "q": 4, "t": 2, "a": 7, "z": 0}
    out, i, cmd, args = [], 0, None, []
    while i < len(d):
        ch = d[i]
        if ch.isspace() or ch == ",":
            i += 1
            continue
        if ch.isalpha():
            cmd, args = ch, []
            out.append(ch)
            i += 1
            continue
        if cmd is None:
            raise ValueError("path data starts with a number")
        n = counts[cmd.lower()]
        if cmd.lower() == "a" and len(args) % 7 in (3, 4):
            if ch not in "01":
                raise ValueError("bad arc flag")
            args.append(ch)
            out.append(ch)
            i += 1
            continue
        m = number.match(d, i)
        if not m or n == 0:
            raise ValueError(f"unexpected {ch!r} in path data")
        args.append(m.group())
        out.append(m.group())
        i = m.end()
    return " ".join(out)


def icons(force):
    """Fetch the Claude Code and Codex logos and keep them as path data
    ({viewBox, paths, evenodd}), which the shell fills with whatever colour
    the palette gives it. Offline, or on anything unexpected, the shell keeps
    its neutral badge and tries again later."""
    import hashlib, re, urllib.request
    os.makedirs(ICONS, exist_ok=True)
    failed = []
    for tool, (url, digest) in ICON_SOURCES.items():
        target = os.path.join(ICONS, f"{tool}.json")
        if os.path.exists(target) and not force:
            continue
        try:
            with urllib.request.urlopen(url, timeout=20) as r:
                data = r.read(256 * 1024)
            if hashlib.sha256(data).hexdigest() != digest:
                raise ValueError("checksum does not match")
            svg = data.decode()
            box = [float(v) for v in re.search(r'viewBox="([^"]+)"', svg).group(1).replace(",", " ").split()]
            paths = re.findall(r'<path[^>]*?\sd="([^"]+)"', svg, flags=re.S)
            if len(box) != 4 or not paths:
                raise ValueError("no path data")
            write_json(target, {"viewBox": box, "paths": [spaced_path(p) for p in paths],
                                "evenodd": "evenodd" in svg, "source": url})
        except Exception as e:
            failed.append(f"{tool} ({e})")
    if failed:
        die("could not fetch " + ", ".join(failed))


# ---- hooks --------------------------------------------------------------------
def hook(tool):
    try:
        data = json.load(sys.stdin)
    except ValueError:
        return
    state = STATES.get(data.get("hook_event_name") or "")
    sid = data.get("session_id") or ""
    if state is None or not sid:
        return
    chain = ancestry(os.getppid())
    spawner = next((p for p in chain if is_tool(p, tool)), 0)
    # The tools run these hooks side by side, so one can land after the one
    # that came next. The time the tool (or Codex's daemon) started this
    # hook's process says which came first.
    below = chain.index(spawner) - 1 if spawner else -1
    order = started(chain[below]) if below >= 0 else 0
    key = f"{tool}:{sid}"
    with live_file() as live:
        sessions = live["sessions"]
        current = sessions.get(key) or {}
        if state == "end":
            sessions.pop(key, None)
            return
        # A session already under way stays as it is. Codex starts
        # SessionStart together with the first prompt's UserPromptSubmit,
        # and its "idle" landing second hid that first reply.
        if state == "idle" and current:
            return
        if order and order < (current.get("order") or 0):
            return
        if current.get("state") == state and state == "working":
            return
        pid, above = current.get("pid") or 0, current.get("chain") or []
        if not pid or is_server(pid):
            pid = session_pid(tool, chain, data.get("cwd") or "")
            # Everything above the tool: the terminal it runs in is one of
            # these, which is how the pill finds the window to focus. The
            # ChatGPT app is that window itself.
            above = [pid] if comm_of(pid) == DESKTOP else ancestry(parent_of(pid)) if pid else []
        sessions[key] = {
            "tool": tool,
            "state": state,
            "since": int(time.time()),
            "order": order,
            "cwd": data.get("cwd") or current.get("cwd") or "",
            "model": data.get("model") or current.get("model") or "",
            "pid": pid,
            "chain": above,
            # Run by the ChatGPT app: shown while it works, not for as long
            # as the app is open, which is all day for everything else in it.
            "app": "chatgpt" if comm_of(pid) == DESKTOP else "",
        }


# ---- connect / disconnect -------------------------------------------------------
def hook_command(tool):
    return f"{shlex.quote(VELA)} ai hook {tool}"


def add_hooks(hooks, events, command, sync=(), timeouts=None):
    for event in events:
        groups = hooks.setdefault(event, [])
        entry = {"type": "command", "command": command, "timeout": (timeouts or {}).get(event, 10)}
        if event not in sync:
            entry["async"] = True
        mine = [h for g in groups for h in g.get("hooks", []) if MARK_HOOK in str(h.get("command", ""))]
        if mine:
            for h in mine:
                h.clear()
                h.update(entry)
        else:
            groups.append({"hooks": [entry]})


def remove_hooks(hooks):
    for event in list(hooks):
        groups = hooks[event]
        if not isinstance(groups, list):
            continue
        for g in groups:
            g["hooks"] = [h for h in g.get("hooks", []) if MARK_HOOK not in str(h.get("command", ""))]
        hooks[event] = [g for g in groups if g.get("hooks")]
        if not hooks[event]:
            del hooks[event]


def connect_claude():
    settings = read_settings(CLAUDE_SETTINGS)
    backup(CLAUDE_SETTINGS)
    current = settings.get("statusLine")
    if isinstance(current, dict) and MARK_STATUS not in str(current.get("command", "")):
        write_json(CLAUDE_PREVIOUS, current)
    elif not current and os.path.exists(CLAUDE_PREVIOUS):
        os.remove(CLAUDE_PREVIOUS)
    line = {"type": "command", "command": f"{shlex.quote(VELA)} ai statusline"}
    previous = read_json(CLAUDE_PREVIOUS) or {}
    for key in ("padding", "refreshInterval", "hideVimModeIndicator"):
        if key in previous:
            line[key] = previous[key]
    settings["statusLine"] = line
    add_hooks(settings.setdefault("hooks", {}), CLAUDE_EVENTS, hook_command("claude"))
    write_json(CLAUDE_SETTINGS, settings, indent=2)


def disconnect_claude():
    if not os.path.exists(CLAUDE_SETTINGS):
        return
    settings = read_settings(CLAUDE_SETTINGS)
    backup(CLAUDE_SETTINGS)
    current = settings.get("statusLine")
    if isinstance(current, dict) and MARK_STATUS in str(current.get("command", "")):
        previous = read_json(CLAUDE_PREVIOUS)
        if isinstance(previous, dict) and previous.get("command"):
            settings["statusLine"] = previous
        else:
            del settings["statusLine"]
    if os.path.exists(CLAUDE_PREVIOUS):
        os.remove(CLAUDE_PREVIOUS)
    if isinstance(settings.get("hooks"), dict):
        remove_hooks(settings["hooks"])
        if not settings["hooks"]:
            del settings["hooks"]
    write_json(CLAUDE_SETTINGS, settings, indent=2)


def connect_codex():
    data = read_settings(CODEX_HOOKS)
    backup(CODEX_HOOKS)
    # SessionEnd hooks always run synchronously in Codex, for three seconds
    # at most; asking for async, or for longer, only earns a warning.
    add_hooks(data.setdefault("hooks", {}), CODEX_EVENTS, hook_command("codex"), sync=("SessionEnd",), timeouts={"SessionEnd": 3})
    write_json(CODEX_HOOKS, data, indent=2)


def disconnect_codex():
    if not os.path.exists(CODEX_HOOKS):
        return
    data = read_settings(CODEX_HOOKS)
    backup(CODEX_HOOKS)
    if isinstance(data.get("hooks"), dict):
        remove_hooks(data["hooks"])
    if data == {"hooks": {}} or not data:
        os.remove(CODEX_HOOKS)
    else:
        write_json(CODEX_HOOKS, data, indent=2)


# ---- status, for the shell --------------------------------------------------------
def codex_windows(limit):
    def window(w):
        if not isinstance(w, dict) or w.get("used_percent") is None:
            return None
        return {"used": float(w["used_percent"]), "minutes": w.get("window_minutes"), "resetsAt": int(w.get("resets_at") or 0)}

    out = {"id": limit.get("limit_id") or "codex", "name": limit.get("limit_name") or "", "primary": window(limit.get("primary")), "secondary": window(limit.get("secondary"))}
    spend = limit.get("individual_limit")
    if isinstance(spend, dict) and spend.get("remaining_percent") is not None:
        out["spend"] = {"used": max(0.0, 100.0 - float(spend["remaining_percent"])), "resetsAt": int(spend.get("resets_at") or 0)}
    return out


def codex_file_usage(path):
    """The newest windows in one session file, per limit (Codex keeps one for
    the plan and may add one per model). Read from the end, where they are."""
    try:
        size = os.path.getsize(path)
        f = open(path, "rb")
    except OSError:
        return None
    found, plan, updated = {}, "", 0
    with f:
        chunk = 256 * 1024
        while True:
            start = max(0, size - chunk)
            f.seek(start)
            lines = f.read(size - start).split(b"\n")
            if start > 0:
                lines = lines[1:]
            for line in reversed(lines):
                if b'"token_count"' not in line or b'"rate_limits"' not in line:
                    continue
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                payload = obj.get("payload") or {}
                limits = payload.get("rate_limits")
                if obj.get("type") != "event_msg" or payload.get("type") != "token_count" or not isinstance(limits, dict):
                    continue
                entry = codex_windows(limits)
                if entry["id"] in found:
                    continue
                found[entry["id"]] = entry
                updated = max(updated, ts(obj.get("timestamp")))
                if not plan and limits.get("plan_type"):
                    plan = str(limits["plan_type"])
            if found or start == 0 or chunk >= 32 * 1024 * 1024:
                break
            chunk *= 4
    if not found:
        return None
    ordered = sorted(found.values(), key=lambda e: e["id"] != "codex")
    return {"updated": updated, "plan": plan, "limits": ordered}


def codex_turn(path):
    """The model and reasoning effort of a session's latest turn."""
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as f:
            f.seek(max(0, size - 512 * 1024))
            lines = f.read().split(b"\n")
    except OSError:
        return None
    for line in reversed(lines):
        if b'"turn_context"' not in line:
            continue
        try:
            obj = json.loads(line)
        except ValueError:
            continue
        payload = obj.get("payload") or {}
        if obj.get("type") == "turn_context" and payload.get("model"):
            effort = payload.get("effort")
            return {"model": payload["model"], "effort": effort if isinstance(effort, str) else ""}
    return None


def codex_usage():
    base = os.path.join(CODEX_DIR, "sessions")
    days = []
    try:
        for y in sorted(os.listdir(base), reverse=True)[:2]:
            for m in sorted(os.listdir(os.path.join(base, y)), reverse=True)[:2]:
                for d in sorted(os.listdir(os.path.join(base, y, m)), reverse=True)[:3]:
                    days.append(os.path.join(base, y, m, d))
    except OSError:
        pass
    files = []
    for day in days[:3]:
        try:
            files += [os.path.join(day, n) for n in os.listdir(day) if n.startswith("rollout-") and n.endswith(".jsonl")]
        except OSError:
            pass
    files.sort(key=lambda p: os.path.getmtime(p) if os.path.exists(p) else 0, reverse=True)
    # A session that has only just started has no reply yet: the one before
    # it has the last numbers. Its model is the newest session's, though.
    turn = next((t for t in (codex_turn(p) for p in files[:3]) if t), None)
    for path in files[:6]:
        usage = codex_file_usage(path)
        if usage:
            if turn:
                usage.update(turn)
            return usage
    return {"updated": 0, "plan": "", "limits": [], **turn} if turn else None


def which(name):
    extra = [os.path.join(HOME, p) for p in (".local/bin", ".npm-global/bin", ".bun/bin", ".volta/bin")] + ["/usr/local/bin"]
    return shutil.which(name, path=os.pathsep.join([os.environ.get("PATH", ""), *extra]))


def processes():
    """Each tool's open sessions, found by process, hooks or not: Codex
    fires none until the first prompt. For each, its pid, the processes above
    it (the terminal is one) and the folder it runs in."""
    found = {"claude": [], "codex": []}
    uid = os.getuid()
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        pid = int(entry)
        # This user's, not another's on the same machine.
        try:
            if os.stat(f"/proc/{pid}").st_uid != uid:
                continue
        except OSError:
            continue
        for tool, sessions in found.items():
            if not is_tool(pid, tool) or not alive(pid):
                continue
            parent = parent_of(pid)
            # The tool's own helpers, its background servers, and the Claude
            # Code `claude-usage` runs for a moment are not sessions.
            if is_tool(parent, tool) or is_server(pid) or cmdline_of(parent).endswith("claude-usage "):
                continue
            sessions.append({"pid": pid, "chain": ancestry(parent), "cwd": workdir(pid, tool)})
    return found


def connected():
    settings = read_json(CLAUDE_SETTINGS, {}) or {}
    line = settings.get("statusLine") if isinstance(settings, dict) else None
    try:
        codex = MARK_HOOK in open(CODEX_HOOKS).read()
    except OSError:
        codex = False
    return {"claude": isinstance(line, dict) and MARK_STATUS in str(line.get("command", "")), "codex": codex}


def status():
    with live_file() as live:
        sessions = live["sessions"]
        # Gone with its process. One on a Codex server is from before vela
        # told the daemon from the session, and would never go. The ChatGPT
        # app need not end a session when you leave its thread, so one there
        # an hour past its last reply is let go; a new prompt brings it back.
        quiet = time.time() - 3600
        for key in [k for k, s in sessions.items() if not alive(int(s.get("pid") or 0)) or is_server(int(s.get("pid") or 0))
                    or (s.get("app") and s.get("state") in ("idle", "done") and (s.get("since") or 0) < quiet)]:
            del sessions[key]
        snapshot = dict(sessions)
    open_now = processes()
    out = {
        "now": int(time.time()),
        "installed": {
            "claude": bool(which("claude")) or os.path.isdir(CLAUDE_DIR),
            "codex": bool(which("codex")) or os.path.isdir(os.path.join(CODEX_DIR, "sessions")),
        },
        "running": {tool: len(found) for tool, found in open_now.items()},
        "open": open_now,
        "connected": connected(),
        "claude": read_json(CLAUDE_USAGE),
        "claudePlan": read_json(CLAUDE_PLAN),
        "icons": {t: read_json(os.path.join(ICONS, f"{t}.json")) for t in ICON_SOURCES},
        "codex": codex_usage(),
        "sessions": snapshot,
    }
    print(json.dumps(out))


args = sys.argv[1:]
cmd = args[0] if args else ""
if cmd == "statusline":
    statusline()
elif cmd == "hook" and len(args) == 2 and args[1] in ("claude", "codex"):
    hook(args[1])
elif cmd == "status":
    status()
elif cmd == "claude-usage":
    claude_usage()
elif cmd == "icons":
    icons("--force" in args[1:])
elif cmd in ("connect", "disconnect") and len(args) == 2 and args[1] in ("claude", "codex"):
    {"connect": {"claude": connect_claude, "codex": connect_codex}, "disconnect": {"claude": disconnect_claude, "codex": disconnect_codex}}[cmd][args[1]]()
    print(f"{args[1]}: {cmd}ed")
    if cmd == "connect" and args[1] == "codex":
        print("codex: open Codex and trust vela's hooks when it asks (or in /hooks) for the live status")
else:
    die("usage: vela ai [status|claude-usage|icons [--force]|connect claude|codex|disconnect claude|codex|statusline|hook claude|codex]")
PY

case "${1:-}" in
    wallpaper) shift; cmd_wallpaper "$@" ;;
    theme)     shift; cmd_theme "$@" ;;
    retint)    shift; cmd_retint "$@" ;;
    shell)     shift; cmd_shell "$@" ;;
    icon-theme) shift; cmd_icon_theme "$@" ;;
    colours)   cat "$STATE_DIR/colours.json" 2>/dev/null || die "no palette generated yet" ;;
    greet)     cmd_greet ;;
    calendar)  shift; cmd_calendar "$@" ;;
    idle)      shift; cmd_idle "$@" ;;
    doctor)    cmd_doctor ;;
    ai)        shift; cmd_ai "$@" ;;
    -h|--help|help|"") usage ;;
    *) die "unknown command: $1 (try 'vela help')" ;;
esac
