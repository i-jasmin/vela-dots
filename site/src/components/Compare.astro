---
// Two pictures of the same thing in one place, with a handle to drag across:
// `before` shows to the left of it, `after` to the right. The handle is a
// range input laid over the pictures, so it can be dragged from anywhere on
// them, moved with the arrow keys, and sits in the middle without scripts.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	before: ImageMetadata;
	after: ImageMetadata;
	beforeLabel: string;
	afterLabel: string;
	// Describes both pictures: the one underneath carries it, the one on top
	// is the same scene again.
	alt: string;
}

const { before, after, beforeLabel, afterLabel, alt } = Astro.props;
---

<figure class="compare not-content">
	<div class="frame">
		<Image src={after} alt={alt} />
		<div class="before">
			<Image src={before} alt="" />
		</div>
		<div class="handle">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6 3 12l6 6M15 6l6 6-6 6"></path></svg>
		</div>
		<input type="range" min="0" max="100" value="50" aria-label={`${beforeLabel} and ${afterLabel}: drag to compare`} />
	</div>
	<figcaption aria-hidden="true"><span>{beforeLabel}</span><span>{afterLabel}</span></figcaption>
</figure>

<script>
	for (const figure of document.querySelectorAll<HTMLElement>('.compare')) {
		const input = figure.querySelector('input');
		input?.addEventListener('input', () => figure.style.setProperty('--at', input.value));
	}
</script>

<style>
	.compare {
		/* Where the split is, 0 to 100. The input's thumb is as wide as the
		   knob, and its centre travels the width less one knob: the split
		   follows the same path, so it stays under the finger. */
		--at: 50;
		--knob: 2.25rem;
		--split: calc(var(--knob) / 2 + (100% - var(--knob)) * var(--at) / 100);
		margin: 1.5rem 0 0;
	}
	.frame {
		position: relative;
		border-radius: 0.75rem;
		overflow: hidden;
		line-height: 0;
		user-select: none;
	}
	img {
		display: block;
		width: 100%;
		height: auto;
	}
	.before {
		position: absolute;
		inset: 0;
		clip-path: inset(0 calc(100% - var(--split)) 0 0);
	}
	.handle {
		position: absolute;
		top: 0;
		bottom: 0;
		left: var(--split);
		width: 2px;
		translate: -1px 0;
		background: white;
		box-shadow: 0 0 0 1px rgb(0 0 0 / 0.2);
		pointer-events: none;
	}
	.handle svg {
		position: absolute;
		top: 50%;
		left: 50%;
		width: var(--knob);
		height: var(--knob);
		translate: -50% -50%;
		padding: 0.45rem;
		border-radius: 50%;
		background: white;
		box-shadow: 0 1px 4px rgb(0 0 0 / 0.35);
		fill: none;
		stroke: #222;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.compare:has(input:focus-visible) .handle svg {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	/* Which side is which, under the pictures rather than on them, where a
	   label would cover part of the screen it is naming. */
	figcaption {
		display: flex;
		justify-content: space-between;
		margin-top: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	/* Invisible, over everything: dragging anywhere moves it. Up-and-down
	   stays with the page, so it still scrolls on a phone. */
	input {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		margin: 0;
		opacity: 0;
		cursor: ew-resize;
		touch-action: pan-y;
		appearance: none;
		background: transparent;
	}
	input::-webkit-slider-thumb {
		appearance: none;
		width: var(--knob);
		height: 100%;
	}
	input::-moz-range-thumb {
		width: var(--knob);
		height: 100%;
		border: 0;
	}
</style>
